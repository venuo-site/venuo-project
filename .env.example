# Configurações do Banco de Dados PostgreSQL (Local / Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=venuo_db

# Configurações do Neon Database (Nuvem - Preencher valores individuais no seu .env real)
NEON_HOST=seu-projeto.aws.neon.tech
NEON_DB=venuo_db
NEON_USER=seu_usuario_neon
NEON_PASSWORD=sua_senha_neon